{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Database": {
    "Provider": "PostgreSQL",
    "ConnectionString": "Host=postgres;Port=5432;Database=novastack_identity;Username=postgres;Password=postgres;Include Error Detail=true",
    "AutoMigrate": true,
    "EnableDetailedErrors": false,
    "EnableSensitiveDataLogging": false,
    "MaxPoolSize": 100
  },

  "Jwt": {
    "Issuer": "NovaStack",
    "Audience": "NovaStack.Clients",
    "SecretKey": "CHANGE_ME_super_secret_key_at_least_32_chars!",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7,
    "ValidateIssuer": true,
    "ValidateAudience": true,
    "ValidateLifetime": true,
    "OpenId": {
      "Authority": "",
      "SupportedScopes": "openid profile email",
      "SupportedResponseTypes": "code token id_token",
      "SupportedGrantTypes": "authorization_code password refresh_token"
    }
  },

  "Cache": {
    "Provider": "InMemory",
    "RedisConnectionString": "redis:6379",
    "DefaultExpiryMinutes": 15,
    "InstanceName": "identity:"
  },

  "Observability": {
    "OtlpEndpoint": ""
  }
}
