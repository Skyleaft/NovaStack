{
  "Database": {
    "Provider": "PostgreSQL",
    "ConnectionString": "Host=localhost;Port=5432;Database=novastack_identity;Username=myuser;Password=mypassword;Include Error Detail=true",
    "AutoMigrate": true,
    "EnableDetailedErrors": true,
    "EnableSensitiveDataLogging": false
  },

  "Authentication": {
    "Issuer": "http://localhost:5010",
    "Audience": [
      "product-api",
      "order-api",
      "inventory-api"
    ],
    "Signing": {
      "Algorithm": "RS256",
      "PrivateKeyPath": "keys/private.pem",
      "PublicKeyPath": "keys/public.pem",
      "KeyId": "forge-key-2026"
    },
    "AccessToken": {
      "LifetimeMinutes": 60
    },
    "RefreshToken": {
      "LifetimeDays": 30
    }
  },

  "Cache": {
    "Provider": "InMemory",
    "DefaultExpiryMinutes": 15,
    "InstanceName": "identity:"
  }
}
