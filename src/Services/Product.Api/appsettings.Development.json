{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },

  "Database": {
    "Provider": "PostgreSQL",
    "ConnectionString": "Host=localhost;Port=5432;Database=novastack_products_dev;Username=myuser;Password=mypassword;Include Error Detail=true",
    "AutoMigrate": true,
    "EnableDetailedErrors": true,
    "EnableSensitiveDataLogging": true
  },

  "Messaging": {
    "Provider": "RabbitMQ",
    "RabbitMQ": {
      "Host": "localhost",
      "Port": 5672,
      "VirtualHost": "/",
      "Username": "guest",
      "Password": "guest"
    },
    "Kafka": {
      "BootstrapServers": "localhost:9092",
      "GroupId": "product-api-group"
    }
  },

  "Cache": {
    "Provider": "InMemory",
    "RedisConnectionString": "localhost:6379"
  },

  "Observability": {
    "OtlpEndpoint": ""
  }
}
