{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Database": {
    "Provider": "PostgreSQL",
    "ConnectionString": "Host=postgres;Port=5432;Database=novastack_identity;Username=postgres;Password=postgres;Include Error Detail=true",
    "AutoMigrate": true,
    "EnableDetailedErrors": false,
    "EnableSensitiveDataLogging": false,
    "MaxPoolSize": 100
  },

  "Authentication": {
    "Issuer": "http://localhost:5010",
    "Audience": [
      "product-api",
      "order-api",
      "inventory-api"
    ],
    "Signing": {
      "Algorithm": "RS256",
      "PrivateKeyPath": "keys/private.pem",
      "PublicKeyPath": "keys/public.pem",
      "KeyId": "forge-key-2026"
    },
    "AccessToken": {
      "LifetimeMinutes": 15
    },
    "RefreshToken": {
      "LifetimeDays": 30
    }
  },

  "Cache": {
    "Provider": "InMemory",
    "RedisConnectionString": "redis:6379",
    "DefaultExpiryMinutes": 15,
    "InstanceName": "identity:"
  },

  "Observability": {
    "OtlpEndpoint": ""
  }
}
